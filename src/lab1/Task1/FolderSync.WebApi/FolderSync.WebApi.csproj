<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FolderSync.Application\FolderSync.Application.csproj" />
    <ProjectReference Include="..\FolderSync.Domain\FolderSync.Domain.csproj" />
    <ProjectReference Include="..\FolderSync.Infrastructure\FolderSync.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\FolderSync.Front\**\*" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
